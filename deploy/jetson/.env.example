# AESOP T3 — Jetson environment
# Copy to .env and fill in real values before first run.
# Generate secrets: openssl rand -hex 32

# ── Postgres ──
POSTGRES_PASSWORD=changeme_generate_with_openssl_rand_hex_32

# ── OmniRoute ──
# JWT for dashboard sessions (openssl rand -base64 48)
JWT_SECRET=
# Encryption key for API keys at rest (openssl rand -hex 32)
API_KEY_SECRET=
# Initial admin password — CHANGE before first use
INITIAL_PASSWORD=CHANGEME
# Path to OmniRoute repo (for Docker build context)
OMNIROUTE_REPO_DIR=../../OmniRoute

# ── Vault sync ──
# Phone's tailnet IP for push access control
PHONE_TAILNET_IP=
